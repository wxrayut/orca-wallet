// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum Role {
  USER
  ADMIN
}

enum AssetType {
  NATIVE
  TOKEN
}

enum TokenStandard {
  NATIVE
  ERC20
  ERC721
  ERC1155
  ERC777
  ERC4626
  UNKNOWN
}

enum TransactionType {
  SEND
  RECEIVE
  CONTRACT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  username String @unique
  password String

  avatar String? // data:${avatar}, avatar is the type of the image (e.g. image/png) and the base64 encoded image data

  role Role @default(USER)

  isVerified Boolean   @default(false)
  isActive   Boolean   @default(true)
  lastLogin  DateTime?

  wallets Wallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Wallet {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  chainId    Int
  blockchain String // ethereum, polygon, bsc, etc.

  label   String?
  address String  @unique

  isDefault Boolean @default(false)

  balance String @default("0") // native balance

  // iv:authTag:encryptedData
  encryptedMnemonic String

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  walletId String @db.ObjectId
  wallet   Wallet @relation(fields: [walletId], references: [id])

  chainId Int
  txHash  String

  type      TransactionType
  assetType AssetType

  fromAddress String
  toAddress   String?

  valueRaw       String? // native value (wei)
  valueFormatted String? // ETH / MATIC etc.

  status TransactionStatus

  blockNumber Int?
  timestamp   DateTime

  receipt   TransactionReceipt?
  transfers TokenTransfer[]

  createdAt DateTime @default(now())

  @@unique([txHash, walletId])

  @@map("transactions")
}

model TransactionReceipt {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String      @unique @db.ObjectId
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  txHash String

  gasUsed           String?
  effectiveGasPrice String?
  feePaid           String?

  blockHash   String?
  blockNumber Int?
  nonce       Int?

  errorReason String?

  createdAt DateTime @default(now())

  @@map("transaction_receipts")
}

model TokenTransfer {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String      @db.ObjectId
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  txHash String

  tokenAddress String?
  symbol       String
  decimals     Int
  standard     TokenStandard

  fromAddress String
  toAddress   String

  amountRaw       String
  amountFormatted String

  createdAt DateTime @default(now())

  @@map("token_transfers")
}